# Не публикуй настоящий DATABASE_URL в GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Google Web OAuth Client ID, не пароль Gmail и не секретный ключ.
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Используй внешний адрес HTTPS-сайта; нужен для проверки Origin.
PUBLIC_BASE_URL=https://viona.space
